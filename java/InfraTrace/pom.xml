<?xml version="1.0" encoding="UTF-8"?>
<!--
    InfraTrace v2 — projeto Java (aplicação desktop em Swing)

    Este é um projeto "Java with Maven". O NetBeans lê este arquivo para saber:
      - a versão do Java usada na compilação (maven.compiler.release);
      - quais bibliotecas baixar (dependencies);
      - qual classe executar no "Run Project" (exec.mainClass).
    Não há Spring nem nenhum framework: só o Java e o driver JDBC do MySQL.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>br.com.infratrace</groupId>
    <artifactId>InfraTrace</artifactId>
    <version>2.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>InfraTrace</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Gera código para Java 21 (qualquer JDK 21 ou mais novo compila) -->
        <maven.compiler.release>21</maven.compiler.release>
        <!-- Classe executada pelo "Run Project" do NetBeans: abre a janela principal.
             (O TesteConexao continua disponível: botão direito nele → Run File.) -->
        <exec.mainClass>Infratrace.App</exec.mainClass>
    </properties>

    <dependencies>
        <!-- Driver JDBC oficial do MySQL (mesma versão do InfraTrace v1).
             É ele que implementa Connection, PreparedStatement e ResultSet para o MySQL. -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>26.10.0</version>
        </dependency>
        <!-- Gson (Google): converte o JSON que a API Python devolve em objetos Java. -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.11.0</version>
        </dependency>
    </dependencies>
</project>
