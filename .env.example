# =====================================================================
# InfraTrace v2 — modelo de configuração
#
# COMO USAR: copie este arquivo para ".env" (nesta mesma pasta, a raiz do
# projeto) e preencha a sua senha do MySQL.
# O ".env" está no .gitignore: a senha NUNCA vai para o GitHub.
# Este mesmo arquivo é lido pelo Java e pelo Python.
# =====================================================================

# Banco de dados MySQL 8
INFRATRACE_DB_HOST=localhost
INFRATRACE_DB_PORT=3306
INFRATRACE_DB_NAME=infratrace_v2
INFRATRACE_DB_USER=root
INFRATRACE_DB_PASSWORD=

# Endereço da API Python (o Java usa para gerar o relatório de garantias
# da tela de Ativos). 127.0.0.1 = só este computador.
INFRATRACE_API_URL=http://127.0.0.1:5000
